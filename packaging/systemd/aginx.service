[Unit]
Description=AGinX native static HTTP server (POC)
After=network.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/local/bin/aginx -listen 127.0.0.1:8080 -root /srv/aginx
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=15s
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=yes
UMask=0027
LimitNOFILE=262144

[Install]
WantedBy=multi-user.target
